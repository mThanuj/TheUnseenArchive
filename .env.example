# Copy this file to .env (same folder) and fill in values. .env is git-ignored -- never commit it.
# Variables already set in your real environment take precedence over this file.

# ---------------------------------------------------------------- Milestone 1 (now)
# Optional. All benchmark models are public; a free read-only token only raises Hugging Face
# download rate limits. Create one at https://huggingface.co/settings/tokens (type: Read).
HF_TOKEN=

# ---------------------------------------------------------------- Cloud GPU (Kaggle, optional)
# Used by `unseen kaggle-bench` / `kaggle-status` / `kaggle-fetch`. Your account must be
# phone-verified (needed for GPU + internet). Token: kaggle.com > Settings > API > Create New Token.
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_API_TOKEN=your-kaggle-api-token

# ---------------------------------------------------------------- Story engine LLMs (optional)
# Without keys the story engine runs on the small local Ollama model (slow, plainer stories). Every
# key below adds free hosted models: the engine uses every provider's best models first (rotating
# to the provider's next model when one hits its free limit), then the normal ones, and the local
# model only last (see llm.chain in config/story.yaml). Free tiers have rate limits and their own
# data-use terms (story prompts are fiction or public facts; never put secrets in prompts).
# GEMINI_API_KEY=your-gemini-api-key          # https://aistudio.google.com/apikey (also Gemma 4, free)
# MISTRAL_API_KEY=your-mistral-api-key        # https://console.mistral.ai (free mode; may train on prompts, opt-out in console)
# GROQ_API_KEY=your-groq-api-key              # https://console.groq.com/keys
# CEREBRAS_API_KEY=your-cerebras-api-key      # https://cloud.cerebras.ai
# OPENROUTER_API_KEY=your-openrouter-api-key  # https://openrouter.ai/keys (":free" models, 50 requests/day)
# CLOUDFLARE_API_TOKEN=your-cloudflare-token  # dash.cloudflare.com > AI > Workers AI > Use REST API (10k Neurons/day)
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id   # shown on the same page
# ZAI_API_KEY=your-zai-api-key                # https://z.ai (GLM Flash models are free)
# NVIDIA_API_KEY=your-nvidia-api-key          # build.nvidia.com; trial for prototyping only, NOT in llm.chain

# ---------------------------------------------------------------- Later milestones
# NOT USED YET. Listed so you can see what will be needed; names may change when implemented.
# M6 publishing (Instagram API with Instagram Login, your own professional account):
# IG_APP_ID=your-instagram-app-id
# IG_APP_SECRET=your-instagram-app-secret
# IG_USER_ID=your-instagram-professional-account-id
# IG_ACCESS_TOKEN=your-long-lived-access-token
