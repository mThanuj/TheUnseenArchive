# Copy this file to .env (same folder) and fill in values. .env is git-ignored -- never commit it.
# Variables already set in your real environment take precedence over this file.

# ---------------------------------------------------------------- Milestone 1 (now)
# Optional. All benchmark models are public; a free read-only token only raises Hugging Face
# download rate limits. Create one at https://huggingface.co/settings/tokens (type: Read).
HF_TOKEN=

# ---------------------------------------------------------------- Later milestones
# NOT USED YET. Listed so you can see what will be needed; names may change when implemented.
# M2 story engine (optional hosted LLM fallback; local Ollama is the default):
# GEMINI_API_KEY=your-gemini-api-key
# M6 publishing (Instagram API with Instagram Login, your own professional account):
# IG_APP_ID=your-instagram-app-id
# IG_APP_SECRET=your-instagram-app-secret
# IG_USER_ID=your-instagram-professional-account-id
# IG_ACCESS_TOKEN=your-long-lived-access-token
# M1b only if local generation fails the gate (Kaggle GPU fallback):
# KAGGLE_API_TOKEN=your-kaggle-api-token
