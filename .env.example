# Copy this file to .env (same folder) and fill in values. .env is git-ignored -- never commit it.
# Variables already set in your real environment take precedence over this file.

# ---------------------------------------------------------------- Milestone 1 (now)
# Optional. All benchmark models are public; a free read-only token only raises Hugging Face
# download rate limits. Create one at https://huggingface.co/settings/tokens (type: Read).
HF_TOKEN=

# ---------------------------------------------------------------- Cloud GPU (Kaggle, optional)
# Used by `unseen kaggle-bench` / `kaggle-status` / `kaggle-fetch`. Your account must be
# phone-verified (needed for GPU + internet). Token: kaggle.com > Settings > API > Create New Token.
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_API_TOKEN=your-kaggle-api-token

# ---------------------------------------------------------------- Story engine LLMs (optional)
# Without keys the story engine runs on the local Ollama model (~4 tok/s on the laptop, a story
# takes 15-30 min). Any key below makes it far faster; providers are tried in the order of
# `llm.chain` in config/story.yaml and keyless ones are skipped. Free tiers have rate limits and
# their own data-use terms (fiction prompts only; never put secrets in prompts).
# GEMINI_API_KEY=your-gemini-api-key          # https://aistudio.google.com/apikey
# GROQ_API_KEY=your-groq-api-key              # https://console.groq.com/keys
# CEREBRAS_API_KEY=your-cerebras-api-key      # https://cloud.cerebras.ai
# OPENROUTER_API_KEY=your-openrouter-api-key  # https://openrouter.ai/keys (add "openrouter" to llm.chain)

# ---------------------------------------------------------------- Later milestones
# NOT USED YET. Listed so you can see what will be needed; names may change when implemented.
# M6 publishing (Instagram API with Instagram Login, your own professional account):
# IG_APP_ID=your-instagram-app-id
# IG_APP_SECRET=your-instagram-app-secret
# IG_USER_ID=your-instagram-professional-account-id
# IG_ACCESS_TOKEN=your-long-lived-access-token
